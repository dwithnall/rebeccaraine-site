---
---

<aside class="sidebar">
  <div class="top">
    <a href="/" class="logo" aria-label="Rebecca Raine — home">
      <img src="/images/rebeccaraine-logo-wm-inv.svg" alt="Rebecca Raine Logo" />
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/books">Books</a>
      <a href="/articles">Articles</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>

  <div class="bottom">
    <div class="socials">
      <button type="button" class="icon-btn" data-open-newsletter title="Newsletter" aria-haspopup="dialog">
        ✉
      </button>
      <a
        class="icon-btn"
        href="https://www.instagram.com/rebeccarainewriter/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram">IG</a
      >
      <a
        class="icon-btn"
        href="https://www.facebook.com/groups/450722123168970"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook">FB</a
      >
      <a
        class="icon-btn"
        href="https://www.goodreads.com/rainewriter"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Goodreads">GR</a
      >
    </div>
    <p class="copyright">© Rebecca Raine. All rights reserved.</p>
  </div>
</aside>

<style>
  .sidebar {
    width: 240px;
    flex: 0 0 240px;
    height: 100vh;
    background: linear-gradient(160deg, var(--primary-ultra-dark), var(--primary));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 28px;
  }

  .top {
    text-align: center;
  }

  .logo {
    display: block;
    margin-bottom: 52px;
  }

  .logo img {
    width: 80%;
    display: block;
    margin: 0 auto;
  }

  .nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    font-family: 'Playfair Display', serif;
  }

  .nav a {
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--white);
  }

  .bottom {
    text-align: center;
  }

  .socials {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .icon-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    color: var(--accent);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
    padding: 0;
    line-height: 1;
    cursor: pointer;
    font-family: inherit;
  }

  button.icon-btn {
    font-size: 14px;
  }

  .copyright {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.65);
    margin: 14px 0 0;
  }
</style>
