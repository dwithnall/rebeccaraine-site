---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const books = await getCollection('books');
const [featuredBook] = [...books].sort((a, b) => b.data.order - a.data.order);
const { Content: BookContent } = await render(featuredBook);

const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentArticles = articles.slice(0, 3);
---

<SiteLayout title="Rebecca Raine — Author">
  <HeroCarousel />

  <section class="latest-work" aria-labelledby="latest-work-heading">
    <div class="section-head">
      <h2 id="latest-work-heading">Latest Work</h2>
      <a href="/books" class="text-link">All Books →</a>
    </div>
    <div class="book-card">
      <a href={`/books/${featuredBook.id}`} class="cover-link">
        <Image
          src={featuredBook.data.cover}
          alt={`${featuredBook.data.title} — cover art`}
          class="cover"
        />
      </a>
      <div class="book-details">
        <h3><a href={`/books/${featuredBook.id}`}>{featuredBook.data.title}</a></h3>
        <p class="tagline">{featuredBook.data.blurb}</p>
        <div class="pov">
          <BookContent />
        </div>
        <div class="cta-row">
          <a href={`/books/${featuredBook.id}`} class="btn-primary">Read More</a>
          <a href={featuredBook.data.amazon} target="_blank" rel="noopener noreferrer" class="text-link underline">Amazon</a>
          <a href={featuredBook.data.goodreads} target="_blank" rel="noopener noreferrer" class="text-link underline">Goodreads</a>
        </div>
      </div>
    </div>
  </section>

  <section class="articles" aria-labelledby="articles-heading">
    <div class="section-head">
      <h2 id="articles-heading">Recent Articles</h2>
      <a href="/articles" class="text-link">All Articles →</a>
    </div>
    <div class="articles-grid">
      {
        recentArticles.map((article) => (
          <a href={`/articles/${article.id}`} class="article-card">
            <span class="article-image-placeholder">{article.data.title} — photo</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.excerpt}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact Rebecca</h2>
    <form class="contact-form">
      <input type="text" name="name" placeholder="Name" autocomplete="name" />
      <input type="email" name="email" placeholder="Email" autocomplete="email" required />
      <textarea name="message" placeholder="Your Message" rows="5"></textarea>
      <button type="submit">Submit</button>
    </form>
  </section>
</SiteLayout>

<style>
  .latest-work,
  .articles,
  .contact {
    box-sizing: border-box;
  }

  .latest-work {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-head h2 {
    font-size: 28px;
    font-weight: 600;
    margin: 0;
  }

  .text-link {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .text-link.underline {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  .book-card {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 44px;
    align-items: start;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 36px;
  }

  .cover-link {
    display: block;
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .book-details h3 {
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 10px;
  }

  .book-details h3 a {
    text-decoration: none;
  }

  .tagline {
    font-style: italic;
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    color: var(--muted);
    margin: 0 0 16px;
  }

  .pov :global(p) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .pov :global(p:last-child) {
    margin-bottom: 24px;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--white);
    padding: 12px 22px;
    border-radius: 2px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .articles {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px 80px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
  }

  .article-card {
    text-decoration: none;
    color: var(--ink);
    display: block;
  }

  .article-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: 16px;
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 4px;
    color: var(--muted);
    font-size: 12px;
    padding: 12px;
  }

  .article-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .article-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  .contact {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px 40px 90px;
  }

  .contact h2 {
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 28px;
    text-align: center;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 36px;
    border-radius: 4px;
  }

  .contact-form input,
  .contact-form textarea {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-size: 15px;
    font-family: inherit;
    background: var(--white);
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    background: var(--accent);
    color: var(--white);
    border: none;
    padding: 14px;
    border-radius: 2px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    form.addEventListener('submit', (e) => e.preventDefault());
  });
</script>
