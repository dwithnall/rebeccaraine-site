---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(articles, { pageSize: 9 });
}

const { page } = Astro.props;

type PageToken = number | 'ellipsis';

function pageNumbers(current: number, last: number): PageToken[] {
  const keep = new Set<number>([1, last, current - 1, current, current + 1]);
  const sorted = [...keep].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
  const result: PageToken[] = [];
  let prev = 0;
  for (const n of sorted) {
    if (prev && n - prev > 1) result.push('ellipsis');
    result.push(n);
    prev = n;
  }
  return result;
}

const tokens = pageNumbers(page.currentPage, page.lastPage);
const hrefForPage = (n: number) => (n === 1 ? '/articles/' : `/articles/${n}/`);
---

<SiteLayout title="Articles — Rebecca Raine" description="Notes from the desk of author Rebecca Raine.">
  <section class="page-head">
    <p class="eyebrow">Notes from the desk</p>
    <h1>Articles</h1>
  </section>

  <section class="articles-grid-wrap">
    <div class="articles-grid">
      {
        page.data.map((article) => (
          <a href={`/articles/${article.id}`} class="article-card">
            <span class="article-image-placeholder">{article.data.title} — photo</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.excerpt}</p>
            <span class="read-more">Read More</span>
          </a>
        ))
      }
    </div>

    {
      page.lastPage > 1 && (
        <nav class="pagination" aria-label="Articles pagination">
          {page.url.prev && (
            <a href={page.url.prev} class="prev-next">&laquo; Prev</a>
          )}
          {tokens.map((t) =>
            t === 'ellipsis' ? (
              <span class="ellipsis">&hellip;</span>
            ) : t === page.currentPage ? (
              <span class="page-num current" aria-current="page">
                {t}
              </span>
            ) : (
              <a href={hrefForPage(t)} class="page-num">
                {t}
              </a>
            )
          )}
          {page.url.next && (
            <a href={page.url.next} class="prev-next">Next &raquo;</a>
          )}
        </nav>
      )
    }
  </section>
</SiteLayout>

<style>
  .page-head {
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px 40px 20px;
    box-sizing: border-box;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 13px;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 12px;
  }

  .page-head h1 {
    font-size: clamp(30px, 4.5vw, 44px);
    font-weight: 600;
    margin: 0;
  }

  .articles-grid-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px 90px;
    box-sizing: border-box;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 36px;
  }

  .article-card {
    text-decoration: none;
    color: var(--ink);
    display: block;
  }

  .article-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: 16px;
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 4px;
    color: var(--muted);
    font-size: 12px;
    padding: 12px;
    box-sizing: border-box;
  }

  .article-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .article-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .read-more {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .pagination {
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    margin-top: 56px;
  }

  .page-num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .page-num.current {
    background: var(--accent);
    color: var(--white);
    border-color: var(--accent);
  }

  .ellipsis {
    color: var(--muted);
  }

  .prev-next {
    text-decoration: none;
    color: var(--muted);
  }
</style>
