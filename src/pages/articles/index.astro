---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout title="Articles — Rebecca Raine" description="Notes from the desk of author Rebecca Raine.">
  <section class="page-head">
    <p class="eyebrow">Notes from the desk</p>
    <h1>Articles</h1>
  </section>

  <section class="articles-grid-wrap">
    <div class="articles-grid">
      {
        articles.map((article) => (
          <a href={`/articles/${article.id}`} class="article-card">
            <span class="article-image-placeholder">{article.data.title} — photo</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.excerpt}</p>
            <span class="read-more">Read More</span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .page-head {
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px 40px 20px;
    box-sizing: border-box;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 13px;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 12px;
  }

  .page-head h1 {
    font-size: clamp(30px, 4.5vw, 44px);
    font-weight: 600;
    margin: 0;
  }

  .articles-grid-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px 90px;
    box-sizing: border-box;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 36px;
  }

  .article-card {
    text-decoration: none;
    color: var(--ink);
    display: block;
  }

  .article-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: 16px;
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 4px;
    color: var(--muted);
    font-size: 12px;
    padding: 12px;
    box-sizing: border-box;
  }

  .article-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .article-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .read-more {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
