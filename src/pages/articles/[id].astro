---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return articles.map((article, i) => ({
    params: { id: article.id },
    props: { article, prev: articles[i - 1] ?? null },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
  prev: CollectionEntry<'articles'> | null;
}

const { article, prev } = Astro.props;
const { Content } = await render(article);

const formattedDate = article.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const category = article.data.tags[0] ?? 'Article';
---

<SiteLayout title={`${article.data.title} — Rebecca Raine`} description={article.data.excerpt}>
  <div class="back-link">
    <a href="/articles">&larr; All Articles</a>
  </div>

  <article class="article-detail">
    <p class="eyebrow">{category} &middot; {formattedDate}</p>
    <h1>{article.data.title}</h1>
    <span class="hero-placeholder">{article.data.title} — hero photo</span>

    <div class="body">
      <Content />
    </div>

    {
      article.data.tags.length > 0 && (
        <div class="tags">
          {article.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
  </article>

  <nav class="prev-next">
    {
      prev ? (
        <a href={`/articles/${prev.id}`} class="prev">
          <span class="label">&larr; Previous</span>
          <span class="title">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    <a href="/articles" class="all">
      <span class="label">All Articles &rarr;</span>
      <span class="title">Browse everything</span>
    </a>
  </nav>
</SiteLayout>

<style>
  .back-link {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px 40px 0;
    box-sizing: border-box;
  }

  .back-link a {
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .article-detail {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 40px 20px;
    box-sizing: border-box;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 14px;
  }

  .article-detail h1 {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 600;
    margin: 0 0 28px;
    line-height: 1.15;
  }

  .hero-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: 36px;
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 4px;
    color: var(--muted);
    font-size: 13px;
    padding: 12px;
    box-sizing: border-box;
  }

  .body :global(p) {
    font-size: 16px;
    line-height: 1.85;
    margin: 0 0 22px;
  }

  .body :global(h3) {
    font-size: 21px;
    font-weight: 600;
    margin: 32px 0 16px;
  }

  .body :global(h4) {
    font-size: 18px;
    font-weight: 600;
    margin: 28px 0 14px;
  }

  .body :global(ul),
  .body :global(ol) {
    font-size: 16px;
    line-height: 1.85;
    margin: 0 0 22px;
    padding-left: 24px;
  }

  .body :global(li) {
    margin-bottom: 6px;
  }

  .body :global(a) {
    color: var(--accent);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 36px 0 0;
  }

  .tag {
    font-size: 12px;
    font-weight: 600;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 20px;
    color: var(--muted);
  }

  .prev-next {
    max-width: 680px;
    margin: 0 auto;
    padding: 20px 40px 90px;
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid var(--line);
  }

  .prev-next a {
    text-decoration: none;
    font-size: 14px;
    color: var(--ink);
  }

  .prev-next .all {
    text-align: right;
    margin-left: auto;
  }

  .prev-next .label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 20px 0 4px;
  }

  .prev-next .title {
    font-weight: 600;
  }
</style>
